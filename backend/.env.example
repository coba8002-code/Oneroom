ROOMAX_DATABASE_URL=postgresql+psycopg://roomax:roomax@localhost:5432/roomax
# 새로 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 잃어버리면 저장된 연락처를 복호화할 수 없습니다 — 백업과 별도로 안전하게 보관
ROOMAX_FIELD_KEY=
ROOMAX_CORS_ORIGINS=http://localhost:3000
# 계약서 파일 저장 폴더 (암호화되어 저장됨)
ROOMAX_UPLOAD_DIR=uploads
# NAVER CLOVA OCR — 콘솔 > CLOVA OCR > Domain > API Gateway 연동에서 발급 (General 도메인)
# 비워 두면 OCR 없이 이미지만 저장하고 값은 직접 입력
ROOMAX_CLOVA_OCR_URL=
ROOMAX_CLOVA_OCR_SECRET=
# 복구 직전 자동 안전 백업 폴더 (백업 파일과 같은 비밀번호로 암호화)
ROOMAX_BACKUP_DIR=backups
# 운영(HTTPS)에서는 true — 세션 쿠키를 HTTPS 로만 보냄
ROOMAX_COOKIE_SECURE=false
ROOMAX_SESSION_DAYS=14
# 메일 속 링크가 가리킬 화면 주소
ROOMAX_APP_URL=http://localhost:3000
# 메일: file(개발 — mail_outbox 폴더에 .eml 저장, 실제 발송 안 함) | smtp(운영)
ROOMAX_MAIL_MODE=file
ROOMAX_MAIL_OUTBOX_DIR=mail_outbox
ROOMAX_MAIL_FROM=ROOMAX <no-reply@example.com>
ROOMAX_SMTP_HOST=
ROOMAX_SMTP_PORT=587
ROOMAX_SMTP_USER=
ROOMAX_SMTP_PASSWORD=
ROOMAX_SMTP_STARTTLS=true

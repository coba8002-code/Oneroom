ROOMAX_DATABASE_URL=postgresql+psycopg://roomax:roomax@localhost:5432/roomax
# 새로 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 잃어버리면 저장된 연락처를 복호화할 수 없습니다 — 백업과 별도로 안전하게 보관
ROOMAX_FIELD_KEY=
ROOMAX_CORS_ORIGINS=http://localhost:3000
# 계약서 파일 저장 폴더 (암호화되어 저장됨)
ROOMAX_UPLOAD_DIR=uploads
# NAVER CLOVA OCR — 콘솔 > CLOVA OCR > Domain > API Gateway 연동에서 발급 (General 도메인)
# 비워 두면 OCR 없이 이미지만 저장하고 값은 직접 입력
ROOMAX_CLOVA_OCR_URL=
ROOMAX_CLOVA_OCR_SECRET=

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "functions": {
    "api/index.py": { "includeFiles": "app/**", "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/api/v1/internal/cron/daily", "schedule": "10 18 * * *" }]
}

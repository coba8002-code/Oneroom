# ── 이 파일을 .env 로 복사해 채우세요. .env 는 깃에 올리지 마세요 ──

# 서비스 도메인 (DNS A 레코드가 이 서버 IP 를 가리켜야 인증서가 발급됨). https:// 없이
SITE_ADDRESS=roomax.example.kr
# 인증서 만료·문제 안내를 받을 주소
ACME_EMAIL=admin@example.kr

# DB 비밀번호 — 영문·숫자만 (주소에 들어가므로). 생성: openssl rand -hex 24
POSTGRES_PASSWORD=

# 연락처·계약서 암호화 키. 생성:
#   docker run --rm python:3.11-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# 잃어버리면 저장된 연락처·계약서를 열 수 없습니다 — 서버 밖 안전한 곳에 따로 보관
ROOMAX_FIELD_KEY=

# 가입 방식: first_only(기본 — 처음 가입한 한 명만, 이후는 초대로만) | open(누구나 — 상용화 때)
ROOMAX_SIGNUP_MODE=first_only
# 첫 대표가 될 내 이메일 — 정해 두면 서버를 켠 뒤 남이 먼저 가입하는 일을 막습니다 (권장)
ROOMAX_OWNER_EMAIL=

# 메일 — 개인 사용이면 비워 둬도 됩니다 (비밀번호를 잊으면 서버에서:
#   docker compose exec api python -m app.admin_cli reset-link 내이메일@example.com )
# 실제로 보내려면 smtp 로 바꾸고 아래를 채우세요. 무료: Gmail SMTP + 앱 비밀번호 (deploy/README.md)
ROOMAX_MAIL_MODE=file
ROOMAX_MAIL_FROM=ROOMAX <no-reply@example.kr>
ROOMAX_SMTP_HOST=
ROOMAX_SMTP_PORT=587
ROOMAX_SMTP_USER=
ROOMAX_SMTP_PASSWORD=
ROOMAX_SMTP_STARTTLS=true

# 정기 백업 (backup 컨테이너) — 8자 이상, 길게 권장. 잃어버리면 정기 백업을 열 수 없습니다
ROOMAX_BACKUP_PASSPHRASE=
# 매일 백업 시각(한국 시각) · 사업장마다 남길 개수 · 해지된 사업장 백업 보관 일수
BACKUP_AT=03:10
BACKUP_KEEP=30
BACKUP_ORPHAN_DAYS=30

# 계약서 OCR (선택) — 비워 두면 OCR 없이 직접 입력
ROOMAX_CLOVA_OCR_URL=
ROOMAX_CLOVA_OCR_SECRET=

ROOMAX_SESSION_DAYS=14
